# Supabase — the same project as apps/cursor (users, admins and auth are
# shared). Locally, `supabase status` prints the default keys.
NEXT_PUBLIC_SUPABASE_URL=<your_supabase_project_url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your_supabase_publishable_key>
SUPABASE_SECRET_KEY=<your_supabase_secret_key>

# xAI API key — picks a submitted bot's category with Grok 4.7. Without it,
# a keyword guess is used.
XAI_API_KEY=

# Public origin of the site, used for canonical links, Open Graph images and
# the sitemap. Defaults to https://grok-bot.directory.
NEXT_PUBLIC_SITE_URL=

# Vercel Firewall rate limits (src/lib/rate-limit.ts). Configure these rules
# in the Vercel dashboard → Firewall:
#   grok-bot-install-per-bot   3 / 24h   (key: `${ip}:${botId}`)
#   grok-bot-install-global    20 / 1h   (key: ip)
#   grok-bot-submit            10 / 1h   (key: userId)
# Locally checkRateLimit is a no-op unless this is set to a deployed host.
NEXT_PUBLIC_VERCEL_FIREWALL_HOST_FOR_DEVELOPMENT=

# Local development only: enables /auth/dev-login, which signs in as a
# password user so the app can be exercised without GitHub/Google OAuth. Never set in
# production (the route also refuses to run outside NODE_ENV=development).
GROK_BOT_DEV_LOGIN=

# Set to 1 to show "Sign in with X" once X (OAuth 2.0) is enabled on the
# Supabase project. Locally: put SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID and
# SUPABASE_AUTH_EXTERNAL_X_SECRET in supabase/.env and enable
# [auth.external.x] in supabase/config.toml.
GROK_BOT_X_SIGN_IN=

# Guards /api/cron/review-bots (Vercel sends it as a Bearer token).
CRON_SECRET=

# Optional. Reading GitHub repositories for app submissions uses the GitHub API:
# 60 requests an hour without a token (a preview or submission uses 2), 5,000
# with one. Any GitHub token with public read access works.
GITHUB_TOKEN=
